# Prefer python3 scripts/setup_env.py to generate your private .env.
COMPOSE_PROJECT_NAME=harbour
FIRST_RUN=True
HARBOUR_ADMIN=admin
# Generated salted scrypt hash, never the plaintext admin password.
HARBOUR_ADMIN_PASSWORD_HASH=
# Generated one-time receipt identifier; removed with admin fields after seeding.
HARBOUR_BOOTSTRAP_ID=
# Generated independently. Keep this: it encrypts SSH and 2FA secrets.
HARBOUR_SECRET=
# Optional value for custom port mappings; the default compose.yaml does not use it.
HARBOUR_BIND_ADDRESS=0.0.0.0
# Externally published HOST port; container/health-check port stays 8080.
HARBOUR_PORT=8080
HARBOUR_SECURE_COOKIE=false
HARBOUR_ORIGIN=http://localhost:8080
HARBOUR_TRUSTED_PROXIES=
# For NPM in Docker on the same host, setup adds:
# COMPOSE_FILE=compose.yaml:compose.npm.yaml
# HARBOUR_PROXY_NETWORK=your-existing-dedicated-network
